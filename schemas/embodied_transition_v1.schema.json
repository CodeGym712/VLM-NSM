{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vlm-nsm.local/schemas/embodied_transition_v1.schema.json",
  "title": "EmbodiedTransition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "run_id",
    "sequence_index",
    "timestamp",
    "task_id",
    "scene_id",
    "seed",
    "pre_predicates",
    "post_predicates",
    "grounded_option",
    "expected_effect",
    "observed_effect",
    "observer",
    "executor",
    "continuous_context",
    "controller_diagnostics",
    "success",
    "raw_failure_type",
    "attribution",
    "attribution_confidence",
    "evidence_ids",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "embodied_transition/v1"},
    "transition_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "sequence_index": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "task_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "pre_predicates": {
      "type": "array",
      "items": {"$ref": "#/$defs/predicateObservation"}
    },
    "post_predicates": {
      "type": "array",
      "items": {"$ref": "#/$defs/predicateObservation"}
    },
    "grounded_option": {"$ref": "#/$defs/groundedOption"},
    "expected_effect": {"$ref": "#/$defs/effect"},
    "observed_effect": {"$ref": "#/$defs/effect"},
    "observer": {"$ref": "#/$defs/versionedComponent"},
    "executor": {"$ref": "#/$defs/versionedComponent"},
    "continuous_context": {"type": "object"},
    "controller_diagnostics": {"type": "object"},
    "success": {"type": "boolean"},
    "raw_failure_type": {"type": ["string", "null"]},
    "attribution": {
      "enum": [
        "SUCCESS",
        "LANGUAGE",
        "SYMBOLIC_INVALID",
        "OBSERVATION_UNCERTAIN",
        "CAPABILITY_OOD",
        "CONTROLLER_FAILURE",
        "MODEL_MISMATCH",
        "EVIDENCE_INVALID"
      ]
    },
    "attribution_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "predicateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args",
        "truth_value",
        "source",
        "confidence",
        "observed_at",
        "freshness_seconds",
        "evidence_id"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "args": {"type": "array", "items": {"type": "string"}},
        "truth_value": {"type": "boolean"},
        "source": {
          "enum": ["oracle", "geometry", "detector", "vlm", "derived", "unknown"]
        },
        "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "observed_at": {"type": "string", "format": "date-time"},
        "freshness_seconds": {"type": "number", "minimum": 0.0},
        "evidence_id": {"type": "string", "minLength": 1}
      }
    },
    "groundedOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "arguments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add", "delete"],
      "properties": {
        "add": {"type": "array", "items": {"$ref": "#/$defs/predicateObservation"}},
        "delete": {"type": "array", "items": {"$ref": "#/$defs/predicateObservation"}}
      }
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
